# Copy to infra/.env and fill in. infra/.env is ignored by git and is never committed.
# Every variable is read from the environment (ADR 0008). The values here are placeholders.

# Image tag of the own services. Use an explicit version in production, never latest.
OPENLOBBY_VERSION=dev

# PostgreSQL superuser, used by the postgres container only (ADR 0008).
POSTGRES_PASSWORD=

# Runtime role (DML) and migration role (owns the database, DDL) per service database (ADR 0006, ADR 0012).
# Use letters and digits only, for example `openssl rand -hex 32`, because they are part of DATABASE_URL.
AUTH_DB_PASSWORD=
AUTH_MIGRATE_DB_PASSWORD=
CALENDAR_DB_PASSWORD=
CALENDAR_MIGRATE_DB_PASSWORD=

# Discord OAuth2 for auth (ADR 0005). Use a separate Discord application for development.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must be registered in the Discord developer portal for this environment, see infra/README.md.
DISCORD_REDIRECT_URI=

# System admins as provider:subject pairs, comma separated. Empty means none (ADR 0011).
SYSTEM_ADMINS=
