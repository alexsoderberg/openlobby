{
  "name": "openlobby-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "openapi-typescript ../api/auth/openapi.yaml -o src/api/gen/auth.ts && openapi-typescript ../api/calendar/openapi.yaml -o src/api/gen/calendar.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^28.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
